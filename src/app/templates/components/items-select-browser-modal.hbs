<OneModal
  @id={{modalId}}
  class="items-select-browser-modal modal-content-overlay"
  @open={{open}}
  @backdropClose={{false}}
  @keyboard={{false}}
  @size="xl"
  @onHide={{onHide}}
  as |modal|
>
  {{#if open}}
    <ItemsSelectBrowser
      @modal={{modal}}
      @parentModalDialogSelector={{parentModalDialogSelector}}
      @selectorModel={{selectorModel}}
      @onCancel={{action "cancel"}}
      @onSubmit={{action "submit"}}
    >
      {{yield}}
    </ItemsSelectBrowser>
  {{/if}}
</OneModal>
