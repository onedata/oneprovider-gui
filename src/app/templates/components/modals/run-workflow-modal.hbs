<GlobalModal
  @classNames="modal-content-overlay"
  @modalId={{modalId}}
  @size="xl"
  as |modal|
>

  <modal.header>
    <h1>
      <span class="one-label">{{tt this "header"}}</span>
    </h1>
    {{#if (and (eq atmWorkflowInputDataSource "filesSelection") atmWorkflowInputData)}}
      <ModalFileSubheader @files={{atmWorkflowInputData}} />
    {{/if}}
  </modal.header>

  <modal.body>
    <SpaceAutomation::AtmWorkflowSchemasList
      @requiredInputStoreSpec={{requiredInputStoreSpec}}
      @onAtmWorkflowSchemaRevisionSelect={{action "atmWorkflowSchemaRevisionSelected"}}
    />
  </modal.body>

  <modal.footer class="btn-toolbar">
    <OneButton @type="default" class="btn-cancel" @onClick={{modal.close}}>
      {{tt this "cancelBtn"}}
    </OneButton>
  </modal.footer>

</GlobalModal>
