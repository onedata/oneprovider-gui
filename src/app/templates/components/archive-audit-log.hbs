<PromiseProxyContainer @proxy={{browsableDatasetProxy}} class="fill-flex-using-column">
  <AuditLogBrowser
    @onFetchLogEntries={{fetchLogEntriesCallback}}
    @customColumnHeaders={{customColumnHeaders}}
    @logEntryDetailsComponentName="archive-audit-log/log-entry-details"
    @logEntryDetailsConfiguration={{logEntryDetailsConfiguration}}
    @doesOpenDetailsOnClick={{true}}
    @isSeverityColumnVisible={{false}}
    @noLogEntriesText={{noLogEntriesText}}
    @updateStrategy={{updateStrategy}}
    as |logEntry|
  >
    {{#let (evaluate-function (action "createEntryModelForRow") logEntry) as |entryModel|}}
      <ArchiveAuditLog::CellFile @entryModel={{entryModel}} />
      <ArchiveAuditLog::CellEvent @entryModel={{entryModel}} />
      {{#unless (media "isMobile")}}
        <ArchiveAuditLog::CellTimeTaken @entryModel={{entryModel}} />
      {{/unless}}
    {{/let}}
  </AuditLogBrowser>
</PromiseProxyContainer>