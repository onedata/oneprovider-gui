{{#component headFirstCellComponentName
  browserModel=browserModel
  onHeadingDragOver=(action "headingDragOver")
  onHeadingDragLeave=(action "headingDragLeave")
  onHeadingDrop=(action "headingDrop")
  isDropBorderShown=isDropBorderShown
}}
  {{yield}}
{{/component}}
{{#each columnsConfiguration.columnsOrder as |columnName i|}}
  {{#if (get columnsConfiguration (concat "columns." columnName ".isVisible"))}}
    <th
      class={{concat-classes
        (concat "fb-table-col-" columnName)
        "fb-table-secondary-col"
        "hidden-xs"
        "draggable-area"
        (if isDropBorderShown "border-dashed")
      }}
      style={{get columnsConfiguration (concat "columnsStyle." columnName)}}
      draggable=true
      ondragstart={{action "headingDrag" columnName}}
      ondragend={{action "headingDragEnd"}}
    >
      <div
        class={{concat-classes "before-drop-area" (if isDropBorderShown "drop-area")}}
        ondragover={{action "headingDragOver" true}}
        ondragleave={{action "headingDragLeave"}}
        ondrop={{action "headingDrop" i}}
      ></div>
      <div
        class={{concat-classes "after-drop-area" (if isDropBorderShown "drop-area")}}
        ondragover={{action "headingDragOver" false}}
        ondragleave={{action "headingDragLeave"}}
        ondrop={{action "headingDrop" (add i 1)}}
      ></div>
      <div class="column-info-container">
        <div
          class="column-name"
          style={{get columnsConfiguration (concat "columnsStyle." columnName)}}
        >
          <div class="column-icon">
            <OneIcon @icon="drag" class="column-move-icon visible-on-hover" />
          </div>
          <TruncatedString>
            {{#if (or
              (eq
                (get columnsConfiguration (concat "columns." columnName ".type"))
                "xattr"
              )
              (eq
                (get columnsConfiguration (concat "columns." columnName ".type"))
                "json"
              )
            )}}
              {{get columnsConfiguration (concat "columns." columnName ".displayedName")}}
            {{else}}
              {{tt this (concat "headers.name." columnName)}}
            {{/if}}
          </TruncatedString>
          <div class="column-icon">
            {{#if (get columnsConfiguration (concat "columns." columnName ".hasTooltip"))}}
              <OneIcon @icon="browser-info" class="column-info-icon">
                <OneTooltip
                  @title={{if (eq
                      (get columnsConfiguration (concat "columns." columnName ".type"))
                      "xattr"
                    )
                    (tt this
                      "headers.tip.xattr"
                      key=(get
                        columnsConfiguration
                        (concat "columns." columnName ".xattrKey")
                      )
                    )
                    (if (eq
                        (get columnsConfiguration (concat "columns." columnName ".type"))
                        "json"
                      )
                      (if (eq
                        (get columnsConfiguration (concat "columns." columnName ".queryType"))
                        "all"
                      )
                        (tt this "headers.tip.json.all")
                        (tt this "headers.tip.json.key" key=(get
                        columnsConfiguration
                        (concat "columns." columnName ".jsonKey")
                      ))
                      )
                      (if (eq columnName "fileId")
                        (tt this
                          (concat
                            "headers.tip."
                            columnName
                            (if previewMode ".public" ".priv")
                          )
                        )
                        (tt this
                          (concat "headers.tip." columnName)
                          oneprovider=currentProviderName
                        )
                      )
                    )
                  }}
                />
              </OneIcon>
            {{/if}}
          </div>
        </div>
        {{#if (get columnsConfiguration (concat "columns." columnName ".hasSubname"))}}
          <div class="column-subname">
            {{#if (eq
              (get columnsConfiguration (concat "columns." columnName ".type"))
              "xattr"
            )}}
              ({{tt this "headers.subname.xattr"}})
            {{else if (eq
              (get columnsConfiguration (concat "columns." columnName ".type"))
              "json"
            )}}
              ({{tt this "headers.subname.json"}})
            {{else}}
              ({{tt this (concat "headers.subname." columnName)}})
            {{/if}}
          </div>
        {{/if}}
      </div>
    </th>
  {{/if}}
{{/each}}
{{columns-configuration-cell
  columnsConfiguration=columnsConfiguration
  isDropBorderShown=isDropBorderShown
  browserModel=browserModel
  dragStartAction=(if browserModel.isUsingUploadArea (action "checkboxDragStart"))
  dragEndAction=(if browserModel.isUsingUploadArea (action "checkboxDragEnd"))
  onHeadingDragOver=(action "headingDragOver" true)
  onHeadingDragLeave=(action "headingDragLeave")
  onHeadingDrop=(action "headingDrop" lastVisibleColumnIndex)
}}