<div class="flex-vertical-center">
  <OneFileIcon class="entry-file-icon" @fileType={{fileType}} />
  {{#if fileName}}
    <span class="entry-file-name truncate">
      <span class="file-name">
        {{fileName}}
      </span>
      {{#if pathItems}}
        <OneTooltip class="string-path-tooltip">
          <div class="formatted-path-string file-path-base">
            <span class="path">
              <FilePathRenderer @pathItems={{pathItems}} />
            </span>
          </div>
        </OneTooltip>
      {{/if}}
    </span>
    {{#if fileNameHash}}
      <span class="log-filename-duplicate-hash">{{fileNameHash}}</span>
    {{/if}}
  {{else}}
    <span class="entry-missing-file-name">–</span>
  {{/if}}
</div>