<td class="pod-id pods-table-data-cell">
  <TruncatedString>{{or podId "—"}}</TruncatedString>
</td>
<td class="pod-readiness pods-table-data-cell">
  {{or podActivity.currentContainersReadiness "—"}}
</td>
<td class="pod-status pods-table-data-cell">
  {{or podActivity.currentStatus "—"}}
</td>
<td class="pod-status-since pods-table-data-cell">
  {{date-format statusSinceTimestamp format="report" blank="—"}}
</td>
