<div class="btn-tooltip-container">
  <OneButton
    @type="primary"
    @buttonType="submit"
    @onClick={{action "createShare"}}
    class="create-share-btn"
    @disabled={{isCreateShareDisabled}}
  >
    {{tt this "createShare"}}
  </OneButton>
  {{#if createShareDisabledTip}}
    <OneTooltip @title={{createShareDisabledTip}} />
  {{/if}}
</div>