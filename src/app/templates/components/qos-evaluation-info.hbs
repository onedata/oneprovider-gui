{{#if qosEvaluationProxy.isRejected}}
  <div class="qos-expression-error text-danger">
    <div class="inline-icon-container">
      <OneIcon @icon="checkbox-filled-warning" class="evaluation-error-icon" />
    </div>
    {{errorMessage}}
  </div>
{{else if qosEvaluationProxy}}
  <LoadingContainer
    @isLoading={{qosEvaluationProxy.isPending}}
    @centered={{false}}
    @sizeClass="xs"
  >
    <QosExpressionInfo @matchingStorages={{qosEvaluationProxy.matchingStorages}} />
  </LoadingContainer>
{{else}}
  <QosExpressionInfo @count={{0}} />
{{/if}}