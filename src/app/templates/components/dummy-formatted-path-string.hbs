{{!-- NOTE: add triggerEvents="" visible=true to one-tooltip to always see tooltip --}}

<a style="display:block;text-align:center;margin: 5em;">
  <span>Hover for file path.</span>
  <OneTooltip class="string-path-tooltip">
    <FormattedPathString class="simple-file-path-0" @absolutePath={{filePath}} />
  </OneTooltip>
</a>


<a style="display:block;text-align:center;">
  <span>Hover for file in archive path.</span>
  <OneTooltip class="string-path-tooltip">
    <FormattedPathString
      class="simple-file-path-1"
      @absolutePath={{fileInArchivePath}}
    />
  </OneTooltip>
</a>