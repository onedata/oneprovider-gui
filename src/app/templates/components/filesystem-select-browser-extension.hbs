<div class="upload-drop-zone {{if dir.dataIsProtected "upload-disabled"}}">
  <div class="upload-info">
    {{#if dir.dataIsProtected}}
      <OneIcon @tagName="div" @icon="ban-left" class="upload-watermark-icon" />
    {{else}}
      <OneIcon @tagName="div" @icon="browser-upload" class="upload-watermark-icon" />
    {{/if}}
  </div>
</div>

{{#if selectorModel.filesToShowInfo}}
  <FileInfoModal
    @open={{true}}
    @space={{selectorModel.space}}
    @browserModel={{browserModel}}
    @files={{selectorModel.filesToShowInfo}}
    @initialTab={{selectorModel.showInfoInitialTab}}
    @dirStatsServiceState={{selectorModel.dirStatsServiceStateProxy.content}}
    @onHide={{action closeInfoModal}}
  />
{{/if}}

{{#if createItemParentDir}}
  <FileBrowser::FbCreateItemModal
    @open={{true}}
    @parentDir={{createItemParentDir}}
    @itemType={{createItemType}}
    @onHide={{action closeCreateItemModal}}
  />
{{/if}}

{{#if fileToRename}}
  <FileBrowser::FbRenameModal
    @open={{true}}
    @file={{fileToRename}}
    @onHide={{action closeRenameModal}}
  />
{{/if}}