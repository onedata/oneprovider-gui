<PromiseProxyContainer @proxy={{requiredDataProxy}}>
  {{#if handle}}
    {{#if xml}}
      {{#if (eq selectedMetadataType MetadataType.Edm)}}
        <ShareShow::Edm
          class="fill-flex-using-column"
          @xmlValue={{xml}}
          @onModify={{action "modifyMetadata"}}
          @isPublished={{true}}
          @isReadOnly={{not isModifyingExistingMetadata}}
          @isPublicView={{publicMode}}
          @space={{space}}
          @share={{share}}
          @shareRootFile={{rootFileProxy.content}}
          @onChangeEditMode={{action "changeEditMode"}}
        />
      {{else if (eq selectedMetadataType MetadataType.DataCite)}}
        <ShareShow::DataCite
          class="fill-flex-using-column"
          @xmlValue={{this.xml}}
          @isPublished={{true}}
          @isReadOnly={{not this.isModifyingExistingMetadata}}
          @isPublicView={{this.publicMode}}
          @space={{this.space}}
          @onModify={{action "modifyMetadata"}}
          @onBack={{action "back"}}
          @onChangeEditMode={{action "changeEditMode"}}
        />
      {{else if (eq selectedMetadataType MetadataType.OpenAire)}}
        <ShareShow::OpenAire
          class="fill-flex-using-column"
          @xmlValue={{this.xml}}
          @isPublished={{true}}
          @isReadOnly={{not this.isModifyingExistingMetadata}}
          @isPublicView={{this.publicMode}}
          @space={{this.space}}
          @onModify={{action "modifyMetadata"}}
          @onBack={{action "back"}}
          @onChangeEditMode={{action "changeEditMode"}}
        />
      {{else}}
        {{!-- Dublin Core is treated also as a fallback --}}
        {{#if (and (not publicMode) isModifyingExistingMetadata)}}
          <ShareShow::DcEditor
            @xmlValue={{xml}}
            @handleService={{selectedHandleService}}
            @isPublished={{true}}
            @isReadOnly={{false}}
            @mode={{dcViewMode}}
            @onModeChange={{action "changeDcViewMode"}}
            @onUpdateXml={{action "updateXml"}}
            @onModify={{action "modifyMetadata"}}
            @onBack={{action "back"}}
            @onChangeEditMode={{action "changeEditMode"}}
          />
        {{else}}
          <ShareShow::DcPreview
            class="fill-flex-using-column"
            @xmlValue={{xml}}
            @handleUrl={{handle.url}}
            @handleServiceName={{handle.handleService.name}}
            @space={{space}}
            @isPublicView={{publicMode}}
            @mode={{dcViewMode}}
            @onModeChange={{action "changeDcViewMode"}}
            @onChangeEditMode={{action "changeEditMode"}}
          />
        {{/if}}
      {{/if}}
    {{else}}
      <p class="no-metadata-info">
        {{tt this "noMetadata"}}
      </p>
    {{/if}}
  {{else}}
    <PromiseProxyContainer @proxy={{handleServicesProxy}}>
      {{#if handleServices.length}}
        <OneCarousel
          @activeSlideId={{activeSlideOfCreator}}
          @animated={{false}}
          class="publicdata-one-carousel full-height"
          as |carousel|
        >
          <carousel.slide @slideId="welcome">
            <ContentInfo
              class={{concat-classes
                "fill-flex-using-column content-info-publish-public-data-welcome"
                "scroll-breakpoint-900"
              }}
              @header={{tt this "publishWelcome.title"}}
              @text={{tt this "publishWelcome.content"}}
              @buttonAction={{action (mut exposePublicDataStarted) true}}
              @buttonLabel={{tt this "publishWelcome.publishButton"}}
              @buttonDisabled={{isWelcomeProceedDisabled}}
              @buttonTip={{welcomeProceedDisabledTip}}
            >
              <p>
                {{tt this "publishWelcome.handleServiceText"}}
                <OneLabelTip @title={{tt this "publishWelcome.handleServiceTextMore"}} />
              </p>
              <div class="row row-handle-service-select">
                <AdaptiveDropdown
                  @triggerClass="select-handle-service"
                  @dropdownClass="select-handle-service-dropdown"
                  @placeholder={{tt this "publishWelcome.selectHandleServicePlaceholder"}}
                  @searchEnabled={{true}}
                  @searchField="name"
                  @selected={{selectedHandleService}}
                  @options={{handleServices}}
                  @onChange={{action (mut selectedHandleService)}}
                  as |handleService|
                >
                  <div
                    class="option-container"
                    data-handle-id={{handleService.entityId}}
                  >
                    <TruncatedString>
                      <NameConflict
                        @item={{hash
                          name=handleService.name
                          conflictLabel=(truncate handleService.entityId 6 false)
                        }}
                        @separator=" #"
                      />
                    </TruncatedString>
                  </div>
                </AdaptiveDropdown>
              </div>
              <p class="metadata-type-text">
                {{tt this "publishWelcome.metadataTypeText"}}
                <OneLabelTip @tooltipClass="tooltip-lg tooltip-text-left">
                  <p>{{tt this "publishWelcome.metadataTypeMore.intro"}}</p>
                  <p>{{tt this "publishWelcome.metadataTypeMore.dublinCore"}}</p>
                  <p>{{tt this "publishWelcome.metadataTypeMore.edm"}}</p>
                  <p>{{tt this "publishWelcome.metadataTypeMore.dataCite"}}</p>
                  <p>{{tt this "publishWelcome.metadataTypeMore.openAire"}}</p>
                  <p>{{tt this "publishWelcome.metadataTypeMore.outro"}}</p>
                </OneLabelTip>
              </p>
              <div class="row row-metadata-type-select">
                <AdaptiveDropdown
                  @triggerClass="select-metadata-type"
                  @dropdownClass="select-metadata-type"
                  @placeholder={{tt this "publishWelcome.selectMetadataTypePlaceholder"}}
                  @selected={{this.selectedMetadataTypeOption}}
                  @options={{this.metadataTypeOptions}}
                  @searchEnabled={{false}}
                  @onChange={{action "selectMetadataTypeOption"}}
                  as |option|
                >
                  <div class="option-container">
                    <TruncatedString>
                      {{option.label}}
                    </TruncatedString>
                  </div>
                </AdaptiveDropdown>
              </div>
            </ContentInfo>
          </carousel.slide>
          <carousel.slide @slideId="createMetadata" class="full-height" as |slide|>
            {{#if (eq slide.state "active-from-right")}}
              {{#if (eq selectedMetadataType MetadataType.Edm)}}
                <ShareShow::Edm
                  class="full-height"
                  @handleService={{selectedHandleService}}
                  @isReadOnly={{false}}
                  @isPublished={{false}}
                  @isPublicView={{false}}
                  @shareRootFile={{rootFileProxy.content}}
                  @share={{share}}
                  @space={{space}}
                  @onUpdateXml={{action "updateXml"}}
                  @onSubmit={{action "submit"}}
                  @onBack={{action "back"}}
                />
              {{else if (eq selectedMetadataType MetadataType.DataCite)}}
                <ShareShow::DataCite
                  class="full-height"
                  @handleService={{this.selectedHandleService}}
                  @isReadOnly={{false}}
                  @isPublished={{false}}
                  @isPublicView={{false}}
                  @initialData={{this.initialData}}
                  @onUpdateXml={{action "updateXml"}}
                  @onSubmit={{action "submit"}}
                  @onBack={{action "back"}}
                />
              {{else if (eq selectedMetadataType MetadataType.OpenAire)}}
                <ShareShow::OpenAire
                  class="full-height"
                  @handleService={{this.selectedHandleService}}
                  @isReadOnly={{false}}
                  @isPublished={{false}}
                  @isPublicView={{false}}
                  @initialData={{this.initialData}}
                  @onUpdateXml={{action "updateXml"}}
                  @onSubmit={{action "submit"}}
                  @onBack={{action "back"}}
                />
              {{else}}
                {{!-- Dublin Core is treated also as a fallback --}}
                <ShareShow::DcEditor
                  @xmlValue={{xml}}
                  @initialData={{initialData}}
                  @handleService={{selectedHandleService}}
                  @isReadOnly={{false}}
                  @isPublished={{false}}
                  @isPublicView={{false}}
                  @onUpdateXml={{action "updateXml"}}
                  @onSubmit={{action "submit"}}
                  @onBack={{action "back"}}
                />
              {{/if}}
            {{/if}}
          </carousel.slide>
        </OneCarousel>
      {{else}}
        <ContentInfo
          class={{if (media "isMobile")
            "scroll-breakpoint-600"
            "scroll-breakpoint-500"
          }}
          @header={{tt this "noHandleServices.title"}}
          @text={{tt this "noHandleServices.content"}}
        />
      {{/if}}
    </PromiseProxyContainer>
  {{/if}}
</PromiseProxyContainer>