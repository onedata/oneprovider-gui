{{#component headFirstCellComponentName
  browserModel=browserModel
  onHeadingDragOver=(action "headingDragOver")
  onHeadingDragLeave=(action "headingDragLeave")
  onHeadingDrop=(action "headingDrop")
  isDropBorderShown=isDropBorderShown
}}
  {{yield}}
{{/component}}
{{#each columnsConfiguration.columnsOrder as |columnName i|}}
  {{#if (get columnsConfiguration (concat "columns." columnName ".isVisible"))}}
    <th
      class={{concat-classes
        (concat "fb-table-col-" columnName)
        "fb-table-secondary-col"
        "hidden-xs"
        "draggable-area"
        (if isDropBorderShown "border-dashed")
      }}
      style={{get columnsConfiguration (concat "columnsStyle." columnName)}}
      draggable=true
      ondragstart={{action "headingDrag" columnName}}
      ondragend={{action "headingDragEnd"}}
    >
      <div
        class={{concat-classes "before-drop-area" (if isDropBorderShown "drop-area")}}
        ondragover={{action "headingDragOver" true}}
        ondragleave={{action "headingDragLeave"}}
        ondrop={{action "headingDrop" i}}
      ></div>
      <div
        class={{concat-classes "after-drop-area" (if isDropBorderShown "drop-area")}}
        ondragover={{action "headingDragOver" false}}
        ondragleave={{action "headingDragLeave"}}
        ondrop={{action "headingDrop" (add i 1)}}
      ></div>
      <FileBrowser::ColumnInfoContainer
        @columnInfo={{get columnsConfiguration (concat "columns." columnName)}}
        @columnStyle={{get columnsConfiguration (concat "columnsStyle." columnName)}}
        @columnName={{columnName}}
        @currentProviderName={{currentProviderName}}
        @browserModel={{browserModel}}
      />
    </th>
  {{/if}}
{{/each}}
{{columns-configuration-cell
  columnsConfiguration=columnsConfiguration
  isDropBorderShown=isDropBorderShown
  browserModel=browserModel
  dragStartAction=(if browserModel.isUsingUploadArea (action "checkboxDragStart"))
  dragEndAction=(if browserModel.isUsingUploadArea (action "checkboxDragEnd"))
  onHeadingDragOver=(action "headingDragOver" true)
  onHeadingDragLeave=(action "headingDragLeave")
  onHeadingDrop=(action "headingDrop" lastVisibleColumnIndex)
}}