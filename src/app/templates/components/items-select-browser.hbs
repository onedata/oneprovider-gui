{{#let
  (component this.modal.header)
  (component this.modal.body)
  (component this.modal.footer)
  as |modalHeader modalBody modalFooter|
}}
  <modalHeader class="items-select-browser-part hide-before-shadow">
    <ItemsSelectBrowser::Header @selectorModel={{selectorModel}}>
      {{yield}}
    </ItemsSelectBrowser::Header>
  </modalHeader>

  <modalBody
    id={{modalBodyId}}
    class="items-select-browser-part upload-drop-zone-container full-width-body"
  >
    <div
      class="items-select-browser-body in-modal-item-browser-container full-width-body-content"
    >
      <PromiseProxyContainer @proxy={{initialRequiredDataProxy}}>
        <FileBrowser
          @browserModel={{browserModel}}
          @parentModalDialogSelector={{parentModalDialogSelector}}
          @showSelectionToolkit={{false}}
          @contentScroll={{contentScroll}}
          @dirStatsServiceState={{selectorModel.dirStatsServiceStateProxy.content}}
          @resolveFileParentFun={{action "resolveItemParent"}}
          @updateDirEntityId={{action "updateDirEntityId"}}
        />

        {{#if selectorModel.browserExtensionComponentName}}
          {{component selectorModel.browserExtensionComponentName
            selectorModel=selectorModel
            browserModel=browserModel
          }}
        {{/if}}
      </PromiseProxyContainer>
    </div>
  </modalBody>

  <modalFooter class="items-select-browser-part">
    <ItemsSelectBrowser::Footer
      @validationError={{validationError}}
      @selectedItems={{selectorSelectedItems}}
      @submitDisabled={{submitDisabled}}
      @submitLabel={{submitLabel}}
      @onCancel={{action "cancel"}}
      @onSubmit={{action "submit"}}
    />
  </modalFooter>
{{/let}}