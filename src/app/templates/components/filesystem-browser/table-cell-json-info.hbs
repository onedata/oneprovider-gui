<div
  class={{concat-classes
    "file-json"
    (if (not (get jsonToShowInCell 1)) "single-line-content")
  }}
  onclick={{action "invokeFileAction" file "metadata" "json"}}
>
  {{#if (not selectedJsonData)}}
    —
  {{else}}
    {{#if (get jsonToShowInCell 1)}}
      <div class="file-json-text">
        <div>
          {{get jsonToShowInCell 0}}
        </div>
        <div>
          {{get jsonToShowInCell 1}}{{#if isTextTruncated}}&#8230;{{/if}}
        </div>
        {{#if isTextTruncated}}
          <OneTooltip class="json-tooltip tooltip-text-left">
            <pre>{{tooltipJsonText}}{{#if isTooltipTextTruncated}}&#8230;{{/if}}</pre>
            {{#if isTooltipTextTruncated}}
              <hr>
              <span class="view-more-text">{{tt this "viewMore"}}</span>
            {{/if}}
          </OneTooltip>
        {{/if}}
      </div>
    {{else}}
      <span class="file-json-text">{{get jsonToShowInCell 0}}</span>
    {{/if}}
    <OneIcon @icon="browser-copy" class="copy-icon" onclick={{action "copyJson"}}/>
  {{/if}}
</div>