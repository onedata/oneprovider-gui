<div
  class="drag-drop-area"
  draggable=true
  ondragstart={{action "headingDrag"}}
  ondragend={{action "headingDragEnd"}}
>
  <div
    class={{concat-classes "before-drop-area" (if isDropBorderShown "drop-area")}}
    ondragover={{action "headingDragOver" true}}
    ondragleave={{action "headingDragLeave"}}
    ondrop={{action "headingDrop" columnIndex}}
  ></div>
  <div
    class={{concat-classes "after-drop-area" (if isDropBorderShown "drop-area")}}
    ondragover={{action "headingDragOver" false}}
    ondragleave={{action "headingDragLeave"}}
    ondrop={{action "headingDrop" (add columnIndex 1)}}
  ></div>
  <div class="space-between-item-area"></div>
  <div class="checkbox-line">
    <OneIcon @icon="drag" class="column-move-icon visible-on-hover" />
    <OneCheckbox
      @inputId={{checkboxInputId}}
      @checked={{get columnValue "isEnabled"}}
      @update={{action "checkboxChanged" columnName}}
      class={{concat-classes "filter-column-checkbox" (concat columnName "-checkbox")}}
    />
    <label
      for={{checkboxInputId}}
      class="column-name-label"
    >
      <TruncatedString>
        {{#if isMetadataColumn}}
          {{get columnValue "displayedName"}}
        {{else}}
          {{tt this (concat translationKey ".name." columnName)}}
        {{/if}}
      </TruncatedString>
      {{#if columnValue.hasSubname}}
        <span class="subname-text">
          ({{subnameText}})
        </span>
      {{/if}}
    </label>
    <div class="icons-container">
      {{#if isMetadataColumn}}
        <div
          class="modify-column icon-container inline-icon-container"
          onClick={{action "openColumnEditor" columnName}}
        >
          <OneIcon @icon="browser-rename" class="visible-on-hover"/>
          {{#if isColumnListVisible}}
            <OneTooltip
              @title={{tt this "modifyTip"}}
            />
          {{/if}}
        </div>
        <div
          class="remove-column icon-container inline-icon-container"
          onClick={{action "removeMetadataColumn" columnName}}
        >
          <OneIcon @icon="close" class="visible-on-hover"/>
          {{#if isColumnListVisible}}
            <OneTooltip
              @title={{tt this "removeTip"}}
            />
          {{/if}}
        </div>
      {{/if}}
      {{#if (and
        (not (get columnValue "isVisible"))
        (get columnValue "isEnabled")
      )}}
        <div class="no-view icon-container">
          <OneIcon @icon="no-view" class="no-view-icon" />
          {{#if isColumnListVisible}}
            <OneTooltip @title={{tt this "noViewTip"}} />
          {{/if}}
        </div>
      {{/if}}
      {{#if columnValue.hasTooltip}}
        <div class="column-info icon-container">
          <OneIcon @icon="browser-info" class="column-info-icon" />
          {{#if isColumnListVisible}}
            <OneTooltip
              @title={{tooltipText}}
            />
          {{/if}}
        </div>
      {{/if}}
      <div class="arrows-container">
        <span
          class="move-down-button icon-container"
          onClick={{action "moveColumnDown" columnName}}
        >
          <OneIcon
            @icon="move-down"
            class={{if isMoveDownIconDisabled "disabled-icon"}}
          />
          {{#if (and
            (and (not isMoveDownIconDisabled) isArrowTooltipVisible)
            isColumnListVisible
          )}}
            <OneTooltip @title={{tt this "moveDown"}} />
          {{/if}}
        </span>
        <span
          class="move-up-button icon-container"
          onClick={{action "moveColumnUp" columnName}}
        >
          <OneIcon
            @icon="move-up"
            class={{if isMoveUpIconDisabled "disabled-icon"}}
          />
          {{#if (and
            (and (not isMoveUpIconDisabled) isArrowTooltipVisible)
            isColumnListVisible
          )}}
            <OneTooltip @title={{tt this "moveUp"}} />
          {{/if}}
        </span>
      </div>
    </div>
  </div>
</div>