<OneModal
  @open={{open}}
  @backdropClose={{not processing}}
  @keyboard={{not processing}}
  @onHide={{action "hide"}}
  @modalClass="proceed-modal archives-delete-modal"
  as |modal|
>
  <ArchivesDelete
    @archives={{archives}}
    @modal={{modal}}
    @processing={{processing}}
    @onClose={{action "hide"}}
    @onProcessingUpdate={{action (mut processing)}}
  />
</OneModal>