<PromiseProxyContainer @proxy={{initialLoadingProxy}} @sizeClass="lg">
  <WorkflowVisualiser
    @mode="view"
    @rawData={{rawSchema}}
    @usedLambdasMap={{usedLambdasMapProxy.content}}
    @actionsFactory={{actionsFactory}}
    @executionDataFetcher={{executionDataFetcher}}
    @pauseResumeExecutionAction={{pauseResumeAction}}
    @cancelExecutionAction={{cancelAction}}
    @forceContinueExecutionAction={{forceContinueAction}}
    @removeExecutionAction={{removeAction}}
  />
</PromiseProxyContainer>
{{yield}}
