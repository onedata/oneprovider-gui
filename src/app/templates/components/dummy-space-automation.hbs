<PromiseProxyContainer @proxy={{spaceProxy}}>
  <SpaceAutomation
    @space={{spaceProxy.content}}
    @tab={{tab}}
    @atmWorkflowExecutionId={{atmWorkflowExecutionId}}
    @atmWorkflowSchemaId={{atmWorkflowSchemaId}}
    @chooseWorkflowSchemaToRun={{action "chooseWorkflowSchemaToRun"}}
    @changeTab={{action "changeTab"}}
    @openPreviewTab={{action "openPreviewTab"}}
    @closePreviewTab={{action "closePreviewTab"}}
  />
</PromiseProxyContainer>
