<GlobalModal
  @classNames="share-modal"
  @modalId={{modalId}}
  @allowClose={{false}}
  @onHide={{action "onHide"}}
  as |modal|
>
  <modal.header>
    <h1>{{tt this "header" fileType=(tt this (concat "fileType." file.type))}}</h1>
    <ModalFileSubheader @files={{array file}} />
    <FileShares::OtherViewForbiddenWarning @file={{file}} @aboutTimeType="future" />
  </modal.header>
  <modal.body>
    <div class="share-modal-loadable-row loadable-row">
      <p>{{tt this "intro"}}</p>
      <p class="share-name-intro">{{tt this "shareNameIntro"}}</p>
      <div class="row">
        <BsForm class="form-horizontal without-labels" as |form|>
          <form.group
            @validation={{if validationError "error"}}
            class={{concat-classes
              "new-share-name-form-group"
              (if validationError "has-message")
            }}
          >
            <input
              id={{inputId}}
              type="text"
              class="form-control new-share-name"
              value={{newShareName}}
              oninput={{action (mut newShareName) value="target.value"}}
              onkeydown={{invoke-on-enter (action "submitNew")}}
              disabled={{isSaving}}
              autofocus=true
            >
            <div class="form-message form-message-name {{unless validationError "transparent"}}">
              {{validationErrorMessage}}
              {{#if (eq validationError "regexp")}}
                <div class="inline-icon-container hint-trigger clickable">
                  <OneLabelTip
                    @title={{tt this "regexpHint"}}
                    class="share-name-regexp-hint"
                  />
                </div>
              {{/if}}
            </div>
          </form.group>
        </BsForm>
      </div>
      <div class="row publish-row">
        <div class="publish-checkbox-group {{if isPublishDisabled "disabled"}}">
          <OneCheckbox
            class="one-checkbox-understand"
            @checked={{isPublishCheckboxChecked}}
            @isReadOnly={{isPublishDisabled}}
            @update={{action "togglePublishCheckbox"}}
          />
          <div
            class="text-publish {{unless isPublishDisabled "clickable"}}"
            onclick={{unless isPublishDisabled (action "togglePublishCheckbox")}}
          >
            {{tt this "publishText"}}
          </div>
        </div>
        {{#if publishTip}}
          <OneLabelTip
            class="publish-label-tip"
            @tooltipClass="tooltip-lg"
            @title={{publishTip}}
          />
        {{/if}}
      </div>
    </div>
  </modal.body>
  <modal.footer>
    <OneButton @onClick={{modal.close}}>
      {{tt this "cancel"}}
    </OneButton>
    <OneButton
      @type="primary"
      @buttonType="submit"
      @onClick={{action "submitNew"}}
      @isPending={{isSaving}}
      @disabled={{submitNewDisabled}}
    >
      {{tt this "createNew"}}
    </OneButton>
  </modal.footer>
</GlobalModal>
