{{#if handleService}}
  <p class="row-publish-info">
    {{tt this "publishInfo"
      handleServiceName=handleService.name
      handleServiceId=handleService.entityId
    }}
  </p>
{{/if}}
<div class="row row-submit">
  <div class="col-xs-12 col-centered col-submit-center btn-toolbar">
    <div class="btn-tooltip-container">
      <OneButton
        class="btn-back"
        @type="warning"
        @disabled={{isCancelDisabled}}
        @onClick={{action "cancel"}}
      >
        <span class="text">
          {{tt this (if (and (not isCreateMode) isEditorModified) "discard" "cancel")}}
        </span>
      </OneButton>
      {{#if cancelButtonTip}}
        <OneTooltip @title={{cancelButtonTip}} />
      {{/if}}
    </div>
    <div class="btn-tooltip-container">
      <OneButton
        @type="primary"
        @buttonType="submit"
        @onClick={{action "submit"}}
        @disabled={{isSubmitDisabled}}
        class="btn-submit"
      >
        {{tt this (if isCreateMode "publish" "save")}}
        {{#if isCreateMode}}
          <span class="hidden-custom-xs">
            {{tt this "asPublicData"}}
          </span>
        {{/if}}
      </OneButton>
      {{#if submitButtonTip}}
        <OneTooltip @title={{submitButtonTip}} />
      {{/if}}
    </div>
    {{#if this.submitWarningIconTip}}
      <OneIcon @icon="sign-warning-rounded" class="submit-warning-icon">
        <OneTooltip @title={{this.submitWarningIconTip}} />
      </OneIcon>
    {{/if}}
  </div>
</div>