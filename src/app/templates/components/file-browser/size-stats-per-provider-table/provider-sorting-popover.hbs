<RenderLater @triggerRender={{isOpened}}>
  <OneWebuiPopover
    @popoverStyle="provider-sorting-popover"
    @open={{isOpened}}
    @triggerSelector={{triggerSelector}}
    @placement={{if (media "isMobile") "bottom" "auto"}}
    as |popover|
  >
    <ClickOutside
      @onClickOutside={{action (mut isOpened) false}}
      @exceptSelector={{triggerSelector}}
    >
      <div class="sorting-popover-header">
        {{tt this "sorting"}}
      </div>
      <OneWayRadioGroup
        class="sorting-method"
        @value={{sortingMethod}}
        @options={{sortingMethodOptions}}
        @update={{action "sortingMethodChanged"}}
        @radioInline={{true}}
      />
    </ClickOutside>
  </OneWebuiPopover>
</RenderLater>