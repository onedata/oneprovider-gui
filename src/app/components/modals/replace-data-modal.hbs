<GlobalModal
  @classNames="replace-data-modal"
  @modalId={{this.modalId}}
  @allowClose={{false}}
  @onHide={{this.onHide}}
  as |modal|
>
  <modal.header>
    <h1>{{tt this "header"}}</h1>
  </modal.header>
  <modal.body>
    <p>{{tt this "intro"}}</p>
    <SingleFileInfo @file={{this.file}} class="existing-file-info" />
  </modal.body>
  <modal.footer>

  </modal.footer>
</GlobalModal>
