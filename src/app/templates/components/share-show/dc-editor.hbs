<div class="metadata-header-section">
  <div
    class={{concat-classes
      colClassname
      "col-public-data-editor-additional metadata-header-section-content"
    }}
  >
    <h1 class="section-name">
      {{tt this (if (media "isMobile") "common.metadataMobile" "common.metadata")}}
      {{#if (media "isMobile")}}
        <OneLabelTip @title={{tt this "common.metadataPublicHeaderTip"}} />
      {{/if}}
    </h1>
    <ShareShow::PublicDataModeSwitch @mode={{mode}} @onModeChange={{action changeMode}} />
    {{#if isModifyButtonShown}}
      <div class="btn-tooltip-container">
        <OneButton
          class="modify-metadata-btn"
          @size="sm"
          @disabled={{true}}
        >
          <OneIcon @icon="browser-rename" />
          {{tt this "common.modify"}}
        </OneButton>
        <OneTooltip @title={{tt this "editor.modifyingButtonTip"}} />
      </div>
    {{/if}}
  </div>
</div>

{{#unless (media "isMobile")}}
  <div class={{concat-classes colClassname "col-public-data-editor-additional"}}>
    <p class="metadata-text">
      {{tt this "editor.metadataEditorIntro"}}
    </p>
    <p class="metadata-text">
      {{tt this "editor.metadataEditorIntroExtra"}}
      <OneLabelTip @title={{tt this "editor.metadataTextMore"}} />
    </p>
  </div>
{{/unless}}

<div class={{concat-classes colClassname "col-public-data-editor-main"}}>
  <OneCarousel @animated={{false}} @activeSlideId={{mode}} as |carousel|>
    <carousel.slide @slideId="visual">
      <div class="row row-metadata-form {{if (eq groupedEntries.length 0) "no-entries"}}">
        {{#each groupedEntries as |group|}}
          <div class="metadata-group">
            <div class="metadata-group-header">
              <h2 class="metadata-group-name">
                {{tt this (concat "common.dcElementNames." group.type)}}
              </h2>
              <div class="group-add-entry">
                <OneButton
                  @type="default"
                  class="btn-sm btn-add-entry"
                  @disabled={{formDisabled}}
                  @onClick={{action "addEntry" group.type}}
                >
                  <OneIcon class="add-icon" @icon="add-filled" />
                  <span class="text">
                    {{tt this "editor.add"}}
                    {{lowercase (tt this (concat "common.dcElementNames." group.type))}}
                  </span>
                </OneButton>
              </div>
            </div>
            {{#each group.values as |value index|}}
              <div class="entry-value-group">
                {{#if (eq group.type "description")}}
                  <textarea
                    class="form-control"
                    data-dc-element-type={{group.type}}
                    rows="4"
                    value={{value}}
                    placeholder={{tt
                      this
                      "editor.inputPlaceholder"
                      type=(lowercase
                        (tt this (concat "common.dcElementNames." group.type))
                      )
                    }}
                    disabled={{formDisabled}}
                    oninput={{action "setValue" group.type index}}
                  ></textarea>
                {{else}}
                  <input
                    class="form-control"
                    type="text"
                    data-dc-element-type={{group.type}}
                    value={{value}}
                    disabled={{formDisabled}}
                    placeholder={{tt
                      this
                      "editor.inputPlaceholder"
                      type=(lowercase
                        (tt this (concat "common.dcElementNames." group.type))
                      )
                    }}
                    oninput={{action "setValue" group.type index}}
                  >
                {{/if}}
                <RemoveIcon
                  @isDisabled={{formDisabled}}
                  @onClick={{action "removeEntry" group.type index}}
                />
              </div>
            {{/each}}
          </div>
        {{/each}}
      </div>
      <div class="row-metadata-group-add">
        <h2>{{tt this "editor.moreElements"}}</h2>
        {{!-- Note: not using AdaptiveDropdown, because we use groups --}}
        <OneDropdown
          @triggerClass="add-metadata-group"
          @dropdownClass="add-metadata-group-dropdown"
          @options={{metadataGroupAddListSorted}}
          @disabled={{formDisabled}}
          @onChange={{action "addMetadataGroup"}}
          @placeholder={{tt this "editor.addMetadataGroup"}}
          @searchEnabled={{true}}
          as |groupType|
        >
          <div class="option-container" data-group-type={{groupType}}>
            <TruncatedString>
              <span class="text">
                {{tt this (concat "common.dcElementNames." groupType)}}
              </span>
            </TruncatedString>
          </div>
        </OneDropdown>
      </div>
    </carousel.slide>
    <carousel.slide @slideId="xml">
      <div class="form-group public-data-xml-form-group {{if parserError "has-error"}}">
        <textarea
          value={{currentXmlValue}}
          oninput={{action "updateXml" value="target.value"}}
          placeholder={{tt this "editor.xmlTextareaPlaceholder"}}
          disabled={{formDisabled}}
          class="no-resize code-textarea public-data-xml-textarea form-control metadata-xml-source-textarea"
        ></textarea>
        <div class="form-message text-right">
          {{#if parserError}}
            {{tt this "editor.xmlParserError"}}
          {{else}}
            {{!-- just hold space for error text --}}
            &nbsp;
          {{/if}}
        </div>
      </div>
    </carousel.slide>
  </OneCarousel>
</div>

<ShareShow::MetadataEditorFooter
  class={{concat-classes colClassname "col-public-data-editor-additional"}}
  @handleService={{handleService}}
  @isCancelDisabled={{formDisabled}}
  @isSubmitDisabled={{submitDisabled}}
  @editMode={{editMode}}
  @onCancel={{action "back"}}
  @onSubmit={{action "submit"}}
/>