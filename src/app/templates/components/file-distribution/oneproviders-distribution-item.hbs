<div class="oneproviders-distribution-item-content">
  <div class={{concat-classes
    "name-section"
  }}>
    <div class="distribution-row-name">
      <TruncatedString @tagName="span" class="storage-name-container">
        <span class="storage-name">{{storageName}}</span>
      </TruncatedString>
      <span class="at-text">{{tt this "at"}}</span>
      <RecordInfoWithIcon @record={{oneprovider}} class="oneprovider-name" />
    </div>
    <div class="distribution-row-name path-container">
      {{#if storageFileLocation}}
        <ClipboardLine
          @value={{storageFileLocation}}
          @size="sm"
          class="storage-file-path-clipboard"
          @buttonTip={{tt this "buttonTip"}}
          @enableValueTip={{true}}
        />
      {{else}}
        <div class="na-location-info-small-screen">
          <OneIcon @icon="browser-info" class="na-location-info-icon">
            <OneTooltip @title={{naLocationTextDetails}}/>
          </OneIcon>
          <span class="na-location-text">{{tt this "unavailable"}}</span>
        </div>
        <span class="na-location-info na-location-text">
          {{#if isNaLocationPrefixVisible}}
            {{tt this "unavailableDetails" details=naLocationTextDetails}}
          {{else}}
            {{naLocationTextDetails}}
          {{/if}}
        </span>
      {{/if}}
    </div>
  </div>
  <OnePillButton @menuItems={{actionsArray}} @theme="light" @useDots={{true}}>
    <StatusToolbar as |toolbar|>
      <toolbar.icon
        @icon="data-receive"
        class={{concat-classes
          "replication-status-icon"
          (if isReplicationInProgress
            (concat-classes statusIconActiveClasses "pulse-mint")
            "inactive"
          )
        }}
        @hint={{tt
          this
          (if isReplicationInProgress "replicationInProgress" "noReplicationInProgress")
        }}
      />
      <toolbar.icon
        @icon="data-send"
        class={{concat-classes
          "migration-status-icon"
          (if isMigrationInProgress
            (concat-classes statusIconActiveClasses "pulse-orange") "inactive"
          )
        }}
        @hint={{tt this
          (if isMigrationInProgress "migrationInProgress" "noMigrationInProgress")
        }}
      />
      <toolbar.icon
        @icon="x"
        class={{concat-classes
          "eviction-status-icon"
          (if isEvictionInProgress
            (concat-classes statusIconActiveClasses "pulse-red")
            "inactive"
          )
        }}
        @hint={{tt this
          (if isEvictionInProgress "evictionInProgress" "noEvictionInProgress")
        }}
      />
    </StatusToolbar>
  </OnePillButton>
  {{#if hasSingleRegFile}}
    <FileDistribution::ChunksVisualizer
      @neverSynchronized={{neverSynchronized}}
      @fileSize={{filesSize}}
      @fileSizeOnStorage={{filesSizeOnStorage}}
      @chunks={{chunksBarData}}
      @roundedPercentage={{roundedPercentage}}
      @percentage={{percentage}}
      @chunksRange={{chunksRange}}
      @chunkCount={{blockCount}}
      @errorOnStorage={{errorOnStorage}}
    />
  {{else}}
    <FileDistribution::ProgressBarVisualizer
      @size={{filesSizeOnStorage}}
      @roundedPercentage={{roundedPercentage}}
      @percentage={{percentage}}
      @getProvidersUrl={{action "getProvidersUrl"}}
      @providerId={{providerId}}
      @errorOnStorage={{errorOnStorage}}
    />
  {{/if}}
</div>
<div class="first-line-breaker"></div>