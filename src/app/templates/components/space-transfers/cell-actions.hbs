<OneMenuToggle
  class={{concat-classes triggerClass}}
  @click={{disable-bubbling (action "toggleActions")}}
/>

<RenderLater @triggerRender={{actionsOpened}}>
  <OneWebuiPopover
    class="transfer-actions"
    @popoverStyle="with-dropdown"
    @padding={{false}}
    @triggerSelector={{triggerSelector}}
    @open={{actionsOpened}}
    @onToggle={{action "toggleActions"}}
  >
    <ClickOutside
      @onClickOutside={{action "toggleActions" false}}
      @exceptSelector={{triggerSelector}}
    >
      <ActionsPopoverContent
        @actionsArray={{menuActions}}
        @actionClicked={{action "toggleActions" false}}
        class="transfer-actions"
      />
    </ClickOutside>
  </OneWebuiPopover>
</RenderLater>

{{#if message}}
  <div class="action-message {{messageType}}">
    {{message}}
    <OneIcon
      @icon="close"
      class="clickable close-message"
      onclick={{action "closeMessage"}}
    />
  </div>
{{/if}}
