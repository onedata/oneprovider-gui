<PromiseProxyContainer
  @proxy={{requiredDataProxy}}
  @sizeClass="lg"
>
  <div class="row share-header-container">
    {{#if publicMode}}
      <ShareShow::HeaderPublic
        @share={{share}}
        @showHandle={{eq handleState "available"}}
      />
    {{else}}
      <ShareShow::HeaderManagement
        @share={{share}}
        @space={{space}}
        @shareRootErrorInfo={{shareRootErrorInfo}}
        @showHandle={{eq handleState "available"}}
        @getDataUrl={{action "getDataUrl"}}
        @onShowShareList={{action "onShowShareList"}}
        @onReloadShareList={{action "reloadShareList"}}
      />
    {{/if}}
    <OneBsTab
      class="bs-tab bs-tab-onedata bs-tab-modern tab-share-show-mode"
      @customTabs={{true}}
      @activeId={{activeTab}}
      as |tab|
    >
      <BsNav
        @type="tabs"
        class={{navTabsShareModeClassname}}
        as |nav|
      >
        {{#each tabIds as |tabId|}}
          <nav.item
            @active={{eq tab.activeId tabId}}
            @disabled={{contains tabId disabledTabs}}
          >
            <a href={{concat "#" tabId}}
              class={{concat "nav-link nav-link-" tabId}}
              role="tab"
              {{action (mut activeTab) tabId}}
            >
              <span class="tab-label {{get tabClasses tabId}}">
                <OneIcon
                  class="tab-icon"
                  @icon={{get tabIcons tabId}}
                />
                <div class="one-label tab-name">
                  {{#if (and
                    (eq tabId "publicdata")
                    (eq handleState "noHandle")
                  )}}
                    {{tt this "tabs.exposePublicData"}}
                  {{else if (and (eq tabId "files") shareRootDeletedProxy.content)}}
                    {{tt this "tabs.filesDeleted"}}
                  {{else}}
                    {{tt this (concat "tabs." tabId)}}
                  {{/if}}
                </div>
              </span>
            </a>
          </nav.item>
        {{/each}}
      </BsNav>
      {{#if areEuLogosShown}}
        <div class="eu-logo-container">
          <a
            href="https://eureka3d.eu"
            target="_blank"
            class="eu-logo logo-eureka3d"
          ></a>
          <a
            href="https://www.europeana.eu"
            target="_blank"
            class="eu-logo logo-europeana"
          ></a>
        </div>
      {{/if}}
    </OneBsTab>
  </div>

  {{#each tabIds as |tabId|}}
    <div
      class="share-show-pane-container share-show-pane-container-{{tabId}} fill-flex-using-column {{if (not (eq activeTab tabId)) "hidden"}}"
    >
      <RenderLater
        @triggerRender={{eq activeTab tabId}}
      >
        {{component (concat "share-show/pane-" tabId)
          class="share-show-pane fill-flex-using-column"
          publicMode=publicMode
          space=space
          share=share
          dirId=dirId
          updateDirId=(action "updateDirId")
          getDataUrl=(action "getDataUrl")
          shareRootDeletedProxy=shareRootDeletedProxy
        }}
      </RenderLater>
    </div>
  {{/each}}

  {{#if publicMode}}
    {{public-footer}}
  {{/if}}
</PromiseProxyContainer>
