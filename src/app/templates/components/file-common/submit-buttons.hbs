<OneButton
  @type="warning"
  @onClick={{action "discard"}}
  @disabled={{isDiscardDisabled}}
  class="btn-discard"
>
  {{tt this "discard"}}
</OneButton>
<div class="btn-tooltip-container">
  <OneButton
    @type="primary"
    @buttonType="submit"
    @onClick={{action "save"}}
    @disabled={{isSaveDisabled}}
    class="btn-save"
  >
    {{tt this "save"}}
  </OneButton>
  {{#if saveTip}}
    <OneTooltip @title={{saveTip}} />
  {{/if}}
</div>