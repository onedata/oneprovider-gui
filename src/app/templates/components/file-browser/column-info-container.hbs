<div
  class="column-name"
  style={{columnStyle}}
>
  <div class="column-icon">
    <OneIcon @icon="drag" class="column-move-icon visible-on-hover" />
  </div>
  <TruncatedString>
    {{#if isMetadataColumn}}
      {{columnInfo.displayedName}}
    {{else}}
      {{tt this (concat "headers.name." columnName)}}
    {{/if}}
  </TruncatedString>
  <div class="column-icon">
    {{#if columnInfo.hasTooltip}}
      <OneIcon @icon="browser-info" class="column-info-icon">
        <OneTooltip @title={{tooltipText}}/>
      </OneIcon>
    {{/if}}
  </div>
</div>
{{#if columnInfo.hasSubname}}
  <div class="column-subname">
    {{#if (eq columnInfo.type "xattr")}}
      ({{tt this "headers.subname.xattr"}})
    {{else if (eq columnInfo.type "json")}}
      ({{tt this "headers.subname.json"}})
    {{else}}
      ({{tt this (concat "headers.subname." columnName)}})
    {{/if}}
  </div>
{{/if}}