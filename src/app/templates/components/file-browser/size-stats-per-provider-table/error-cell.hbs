{{#if (eq sizeStats.error.id "dirStatsDisabledForSpace")}}
  <a
    href={{providerUrl}}
    class="dir-statistics-settings-url navy"
    target={{navigateTarget}}
  >
    <OneIcon @icon="overview" class="inline-icon-container dir-stats-icon" />
    {{tt this "disabledStatistics"}}
    <OneTooltip @title={{tt this "disabledStatisticsTip"}} />
  </a>
{{else}}
  <OneIcon @icon="sign-warning-rounded" class="inline-icon-container" />
  {{errorMessage}}
{{/if}}