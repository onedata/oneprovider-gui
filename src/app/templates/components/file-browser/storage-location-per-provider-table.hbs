<tr class="oneprovider-name-row">
  <td colspan="2" class="oneprovider-name-cell">
    <TruncatedString class="provider-record">
      <RecordInfoWithIcon @record={{oneprovider}} />
      &nbsp;
      <span class="provider-details">
        ({{tt this (if (eq currentProviderId oneprovider.entityId) "local" "remote")}})
      </span>
    </TruncatedString>
  </td>
</tr>
{{#each locations as |location|}}
  <tr class="oneprovider-storage-location-row">
    {{#if location.storageName}}
      <td class="storage-name-cell">
        <TruncatedString>
          {{location.storageName}}
        </TruncatedString>
      </td>
      <td class="location-cell">
        {{#if location.path}}
          <ClipboardLine
            @value={{location.path}}
            @size="sm"
            class="location-cell-clipboard"
          />
        {{else}}
          <span class="empty-location-cell">–</span>
        {{/if}}
      </td>
    {{else}}
      <td colspan="2" class="error-cell">
        <TruncatedString>
          <OneIcon @icon="sign-warning-rounded" class="inline-icon-container" />
          {{errorMessage}}
        </TruncatedString>
      </td>
    {{/if}}
  </tr>
{{/each}}
