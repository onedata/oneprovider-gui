<PromiseProxyContainer
  @proxy={{spaceProxy}}
>
  {{#if shareId}}
    <PromiseProxyContainer
      @proxy={{shareProxy}}
      @spinnerBlockClass="absolute-middle-centered"
      @sizeClass="lg"
      @loadingLabel={{oneproviderName}}
    >
      <ShareShow
        @share={{shareProxy.content}}
        @dirId={{dirId}}
        @initialTabId={{initialTabId}}
        @space={{spaceProxy.content}}
        @updateDirId={{action "updateDirId"}}
        @getDataUrl={{action "getDataUrl"}}
        @onShowShareList={{action "onShowShareList"}}
        @reloadShareList={{action "reloadShareList"}}
      />
    </PromiseProxyContainer>
  {{else}}
    <SpaceShares::SharesList
      @space={{spaceProxy.content}}
      @onGetShareUrl={{action "getShareUrl"}}
      @onGetDataUrl={{action "getDataUrl"}}
      @onStartRemoveShare={{action "startRemoveShare"}}
      @onStartRenameShare={{action "startRenameShare"}}
    />
  {{/if}}

  <RenderLater @triggerRender={{shareToRemove}}>
    <SpaceShares::RemoveModal
      @share={{shareToRemove}}
      @fileSharesCount={{fileSharesCount}}
      @opened={{bool shareToRemove}}
      @close={{action "closeRemoveShare"}}
    />
  </RenderLater>

  <RenderLater @triggerRender={{shareToRename}}>
    <SpaceShares::RenameModal
      @shareId={{shareToRename.id}}
      @initialName={{shareToRename.name}}
      @opened={{bool shareToRename}}
      @close={{action "closeRenameShare"}}
    />
  </RenderLater>

</PromiseProxyContainer>
