{{#if (media "isMobile")}}
  <td>
    {{#if sizeStats.error}}
      <FileBrowser::SizeStatsPerProviderTable::ErrorCell @sizeStats={{sizeStats}} />
    {{else}}
      <div>
        <span class="contains-label">
          {{tt this "fileCounters.containsLabel"}}:
        </span>
        <span class="contains-value">
          {{stringifiedLatestElementsCount}}
        </span>
      </div>
      <div>
        <span class="logical-size-label">
          {{tt this "fileCounters.logicalSizeLabel"}}:
        </span>
        <span class="logical-size-value">
          {{bytes-to-string sizeStats.logicalSize}}
          {{#if (gte sizeStats.logicalSize 1024)}}
            <span class="extra-info">
              ({{format-number sizeStats.logicalSize}}&nbsp;B)
            </span>
          {{/if}}
        </span>
      </div>
      <div>
        <span class="physical-size-label">
          {{tt this "fileCounters.physicalSizeLabel"}}:
        </span>
        <span class="physical-size-value">
          {{bytes-to-string sizeStats.totalPhysicalSize}}
          {{#if (gte sizeStats.totalPhysicalSize 1024)}}
            <span class="extra-info">
              ({{format-number sizeStats.totalPhysicalSize}}&nbsp;B)
            </span>
          {{/if}}
        </span>
      </div>
      {{#if this.isVirtualSizeColumnShown}}
        <div class="virtual-size-container">
          <span class="virtual-size-label">
            {{tt this "fileCounters.virtualSizeLabel"}}:
          </span>
          <span class="virtual-size-value">
            {{#if (eq sizeStats.virtualSize undefined)}}
              <SpinSpinnerBlock
                class="virtual-size-spinner"
                @tagName="span"
                @sizeClass="xs"
              />
            {{else}}
              {{bytes-to-string sizeStats.virtualSize}}
              {{#if (gte sizeStats.virtualSize 1024)}}
                <span class="extra-info">
                  ({{format-number sizeStats.virtualSize}}&nbsp;B)
                </span>
              {{/if}}
            {{/if}}
          </span>
        </div>
      {{/if}}
    {{/if}}
  </td>
{{else}}
  <td class={{concat-classes "header" (if isCurrentProvider "current-provider")}}>
    <RecordInfoWithIcon @record={{sizeStats.provider}} />
    {{#if this.isErrorIconShown}}
      <OneIcon @icon="checkbox-filled-warning" class="error-occurs-icon">
        <OneTooltip @title={{tt this "fileCounters.providerOccursErrorsTip"}} />
      </OneIcon>
    {{else if (and sizeStats.error (not-eq sizeStats.error.id "dirStatsDisabledForSpace"))}}
      <OneIcon @icon="sign-warning-rounded" class="inline-icon-container warning-icon">
        {{#if (eq this.sizeStats.error.id "noConnectionToPeerOneprovider")}}
          <OneTooltip @title={{tt this "fileCounters.providerOfflineTip"}} />
        {{/if}}
      </OneIcon>
    {{else if (and sizeStats.error (eq sizeStats.error.id "dirStatsDisabledForSpace"))}}
      <OneIcon @icon="browser-info" class="info-icon">
        <OneTooltip @title={{tt this "fileCounters.dirStatsDisabledTip"}} />
      </OneIcon>
    {{/if}}
  </td>
  {{#if sizeStats.error}}
    <td colspan={{if this.isVirtualSizeColumnShown "4" "3"}}>
      <FileBrowser::SizeStatsPerProviderTable::ErrorCell @sizeStats={{sizeStats}} />
    </td>
  {{else}}
    <td class={{concat-classes "contains-value" (if this.isErrorIconShown "danger-text")}}>
      {{tt this "fileCounters.containsLabel"}}:
      {{stringifiedLatestElementsCount}}
    </td>
    <td class={{concat-classes "logical-size-value" (if this.isErrorIconShown "danger-text")}}>
      {{bytes-to-string sizeStats.logicalSize}}
      {{#if (gte sizeStats.logicalSize 1024)}}
        <span class="extra-info">
          ({{format-number sizeStats.logicalSize}}&nbsp;B)
        </span>
      {{/if}}
    </td>
    <td class={{concat-classes "physical-size-value" (if this.isErrorIconShown "danger-text")}}>
      {{bytes-to-string sizeStats.totalPhysicalSize}}
      {{#if (gte sizeStats.totalPhysicalSize 1024)}}
        <span class="extra-info">
          ({{format-number sizeStats.totalPhysicalSize}}&nbsp;B)
        </span>
      {{/if}}
    </td>
    {{#if this.isVirtualSizeColumnShown}}
      <td class={{concat-classes "virtual-size-value" (if this.isErrorIconShown "danger-text")}}>
        {{#if (eq sizeStats.virtualSize undefined)}}
          <SpinSpinnerBlock
            class="virtual-size-spinner"
            @tagName="span"
            @sizeClass="xs"
          />
        {{else}}
          {{bytes-to-string sizeStats.virtualSize}}
          {{#if (gte sizeStats.virtualSize 1024)}}
            <span class="extra-info">
              ({{format-number sizeStats.virtualSize}}&nbsp;B)
            </span>
          {{/if}}
        {{/if}}
      </td>
    {{/if}}
  {{/if}}
{{/if}}
