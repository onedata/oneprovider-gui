<div class="content-file-browser content-items-browser one-embedded-component">
  <PromiseProxyContainer @proxy={{this.dirProxy}}>
    <FileBrowser @browserModel={{this.browserModel}} />

    {{#if this.fileToRename}}
      <FileBrowser::FbRenameModal
        @open={{true}}
        @file={{this.fileToRename}}
        @onHide={{action "closeRenameModal"}}
      />
    {{/if}}

    {{#if this.filesToRemove}}
      <FileBrowser::FbRemoveModal
        @open={{true}}
        @files={{this.filesToRemove}}
        @onHide={{action "closeRemoveModal"}}
      />
    {{/if}}
  </PromiseProxyContainer>
</div>
