<p class="confirm-subsequent-transfer-message break-word">{{messageText}}</p>
<div class="btn-toolbar">
  <OneButton
    @onClick={{onCancel}}
    @disabled={{not canCancel}}
    @size="sm"
    class="cancel-subsequent-transfer"
  >
    {{tt this "cancelButton"}}
  </OneButton>
  <OneButton
    @type="primary"
    @size="sm"
    @buttonType="submit"
    @onClick={{action "confirm"}}
    class="confirm-subsequent-transfer"
  >
    {{confirmButtonText}}
  </OneButton>
</div>
{{yield}}
