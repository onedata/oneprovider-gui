{{#if (gt inputStoresFieldsCollectionGroup.useSelectionPossibilitesCount 1)}}
  <div class="alert alert-info text-center cannot-guess-store-warning">
    {{tt this "cannotGuessStoreForSelection"}}
  </div>
{{/if}}
<form class="form form-horizontal form-component">
  <FormComponent::FieldRenderer @field={{fields}} />
</form>
<ItemsSelectBrowserModal
  @open={{itemsSelectionProcess}}
  @selectorModel={{itemsSelectionProcess.selectorModel}}
  @onHide={{action "itemsSelectorClose"}}
  @onSubmit={{action "itemsSelected"}}
  @onCancel={{action "itemsSelectorClose"}}
>
  <h2 class="normal-case">
    {{tt this "itemsSelectorSubheader" storeName=itemsSelectionProcess.atmStore.name}}
  </h2>
</ItemsSelectBrowserModal>
{{yield}}
