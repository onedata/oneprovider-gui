<OneButton
  class="cancel-archive-creation-btn"
  @type="default"
  @disabled={{isSubmitting}}
  @onClick={{action "close"}}
>
  {{tt this "cancel"}}
</OneButton>
<OneButton
  @type="primary"
  @buttonType="submit"
  class="submit-archive-creation-btn"
  @disabled={{disabled}}
  @isPending={{isSubmitting}}
  @onClick={{action "submit"}}
>
  {{tt this "create"}}
</OneButton>
