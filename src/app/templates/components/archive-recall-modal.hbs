<OneModal
  @modalId={{modalId}}
  @modalClass="archive-recall-modal modal-content-overlay"
  @open={{open}}
  @size="xl"
  @backdropClose={{false}}
  @keyboard={{false}}
  @onHide={{action "hide"}}
  as |modal|
>
  <ArchiveRecall
    @modal={{modal}}
    @modalId={{modalId}}
    @space={{space}}
    @archive={{archive}}
    @options={{options}}
    @onCancel={{action "hide"}}
    @onArchiveRecallStarted={{action "recallStarted"}}
  />
  {{yield}}
</OneModal>
