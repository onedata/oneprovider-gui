{{#if this.isShareNameWarningShown}}
  <div class="alert alert-warning share-name-validation-alert">
    <div class="share-validation-message">
      {{tt this "shareNameDoesNotMatch"
        shareName=this.share.name
        metadataTitle=this.firstMetadataTitle
      }}
    </div>
    <div class="share-validation-buttons">
      <OneButton
        @type="default"
        @size="sm"
        @onClick={{this.dismissName}}
      >
        {{tt this "dismiss"}}
      </OneButton>
      <OneButton
        @type="primary"
        @size="sm"
        @onClick={{this.applyName}}
      >
        {{tt this "applyName"}}
      </OneButton>
    </div>
  </div>
{{/if}}