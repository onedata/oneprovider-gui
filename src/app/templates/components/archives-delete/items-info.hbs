{{#if isSingleItem}}
  <div class="single-file-info details-with-icon">
    <OneIcon @icon="browser-archive" class="details-icon" />
    <div class="details-content">
      <TruncatedString class="single-file-info-file-name details-title">
        {{firstItem.name}}
      </TruncatedString>
      <ul class="details-property-list">
        <li class="property-row">
          <span class="property-label">{{tt this "archived"}}:</span>
          <ArchiveContentCount @archive={{firstItem}} class="property-value" />
        </li>
      </ul>
    </div>
  </div>
{{else}}
  <div class="row row-items-list">
    {{#each items as |item|}}
      <div class="row-item">
        <div class="browsable-item-icon">
          <OneIcon @icon="browser-archive" />
        </div>
        <TruncatedString class="single-browsable-item-name">
          {{item.name}}
        </TruncatedString>
        <OneLabelTip
          @tooltipClass="browsable-items-info-tooltip"
          class="item-info-tip-trigger"
          @icon="sign-info-rounded"
        >
          <div class="text-left">
            <span class="item-info-label">
              {{tt this "archived"}}:
            </span>
            <span class="item-info-value archive-size">
              <ArchiveContentCount @archive={{item}} />
            </span>
          </div>
        </OneLabelTip>
      </div>
    {{/each}}
  </div>
{{/if}}
