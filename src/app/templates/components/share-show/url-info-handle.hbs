<p>
  {{tt this "intro"}}
</p>
{{#if share.handle.handleService.name}}
  <p class="handle-service-name">
    {{tt this "handleServiceInfoText"
      handleServiceName=share.handle.handleService.name
    }}
  </p>
{{/if}}
<p>
  <label class="control-label">
    <strong>{{tt this "handleId"}}:</strong>
    <OneLabelTip @title={{tt this "handleIdTip"}} />
  </label>
  <OneClipboardLine
    class="handle-id-clipboard-line"
    @size="sm"
    @value={{share.handle.entityId}}
  />
</p>
{{#if share.handle.handleService.entityId}}
  <p>
    <label class="control-label">
      <strong>{{tt this "handleServiceId"}}:</strong>
      <OneLabelTip @title={{tt this "handleServiceIdTip"}} />
    </label>
    <OneClipboardLine
      class="handle-service-id-clipboard-line"
      @size="sm"
      @value={{share.handle.handleService.entityId}}
    />
  </p>
{{/if}}
<hr class="sharp">
<p class="last">
  {{tt this "selectorInfo"}}
</p>