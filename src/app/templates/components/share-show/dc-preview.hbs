<div class="metadata-header-section">
  <div class="metadata-header-section-content">
    <h1 class="section-name">
      {{tt this (if (media "isMobile") "common.metadataMobile" "common.metadata")}}
      <OneLabelTip @title={{tt this "common.metadataPublicHeaderTip"}} />
    </h1>
    <ShareShow::PublicDataModeSwitch @mode={{mode}} @onModeChange={{action changeMode}} />
    {{#unless isPublicView}}
      <div class="btn-tooltip-container">
        <OneButton
          class="modify-metadata-btn"
          @size="sm"
          @onClick={{action "startModify"}}
          @disabled={{isModifyDisabled}}
        >
          <OneIcon @icon="browser-rename" />
          {{tt this "common.modify"}}
        </OneButton>
        {{#if modifyDisabledTip}}
          <OneTooltip @title={{modifyDisabledTip}} />
        {{/if}}
      </div>
    {{/unless}}
  </div>
</div>
<div class="row-metadata-presenter">
  {{#if groupedEntries.length}}
    <div class="col-xs-12 col-md-8 col-lg-7">
      <OneCarousel @animated={{false}} @activeSlideId={{mode}} as |carousel|>
        <carousel.slide @slideId="visual">
          {{#each groupedEntries as |group|}}
            <div class="metadata-group">
              <h2 class="metadata-group-name">
                {{tt this (concat "common.dcElementNames." group.type)}}
              </h2>
              {{#each group.values as |value|}}
                <div class="metadata-value public-data-value">
                  {{value}}
                </div>
              {{/each}}
            </div>
          {{/each}}
        </carousel.slide>
        <carousel.slide @slideId="xml">
          <OneClipboardLine
            @inputClass="public-data-xml-textarea"
            @type="textarea"
            @value={{xmlValue}}
          />
        </carousel.slide>
      </OneCarousel>
    </div>
    <div class="hidden-xs hidden-sm col-md-4 col-lg-5 col-public-data-logo">
      <div class="public-data-logo">
      </div>
    </div>
  {{else}}
    <p class="no-dublin-core">
      {{tt this "preview.noMetadata"}}
    </p>
  {{/if}}
</div>
