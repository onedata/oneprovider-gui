<AuditLogBrowser
  @onFetchLogEntries={{fetchLogEntriesCallback}}
  @customColumnHeaders={{customColumnHeaders}}
  as |logEntry|
>
  <FileRecall::EventLog::CellFile
    @fileCdmiObjectId={{logEntry.content.fileId}}
    @relativePath={{logEntry.content.relativePath}}
    @duplicateNameHashMapper={{duplicateNameHashMapper}}
    @onGenerateSourceFileUrl={{action "generateSourceFileUrl"}}
  />
  <FileRecall::EventLog::CellError @reason={{logEntry.content.reason}} />
</AuditLogBrowser>
