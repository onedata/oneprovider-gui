<PromiseProxyContainer
  @proxy={{dataProxy}}
  @sizeClass="lg"
  @loadingLabel={{oneproviderName}}
>
  {{#if shares.length}}
    <div class="one-collapsible-list">
      {{#each sortedShares as |share|}}
        <SpaceShares::ListItem
          @space={{space}}
          @share={{share}}
          @pointsToDeletedFile={{contains share sharesWithDeletedFiles}}
          @getShareUrl={{action "getShareUrl"}}
          @startRemoveShare={{action "startRemoveShare"}}
          @startRenameShare={{action "startRenameShare"}}
        />
      {{/each}}
    </div>
  {{else}}
    <ContentSharesEmpty @forSpace={{true}} @dataTabUrl={{dataTabUrl}} />
  {{/if}}
</PromiseProxyContainer>
