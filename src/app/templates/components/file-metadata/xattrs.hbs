<p class="metadata-description">{{tt this "description"}}</p>
<form
  onsubmit={{prevent-default}}
  role="form"
  class="form form-horizontal"
  onkeypress={{ignore-enter}}
>
  {{#if isReadOnly}}
    {{#each metadataForPreview key="key" as |item|}}
      <div class="col-xs-12 form-group">
        <div class="row">
          <div class="label-column col-xs-12 col-sm-5 control-label">
            <div class="one-inline-editor static">
              <TruncatedString>{{item.key}}</TruncatedString>
              <span class="action-icons">
                <OneIcon @icon="lock" />
              </span>
            </div>
          </div>
          <div class="form-control-column col-xs-12 col-sm-7">
            <OneClipboardLine @value={{item.value}} @inputValue="qos-field" />
          </div>
        </div>
      </div>
    {{/each}}
  {{else}}
    {{!-- TODO: VFS-9695 remove used of lastResetTime --}}
    <QosParamsEditor
      @mode="edit"
      @qosParams={{metadataForEditor}}
      @isFormOpened={{true}}
      class="xattrs-params-editor"
      @showHeader={{false}}
      @layoutConfig={{layoutConfig}}
      @lastResetTime={{lastResetTime}}
      @onChange={{action "xattrsChanged"}}
      @validateKey={{action "validateKey"}}
    />
  {{/if}}
</form>
{{yield}}