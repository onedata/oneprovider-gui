{{#if (media "isMobile")}}
  {{#each sortedDirSizeStatsValues key="provider" as |sizeStats|}}
    <div class="current-size-table-container">
      <table class="current-size-table table table-info">
        <thead>
          <tr>
            <td>
              <RecordInfoWithIcon @record={{sizeStats.provider}} />
            </td>
          </tr>
        </thead>
        <tbody>
          <FileBrowser::SizeStatsPerProviderTable::ProviderRow
            @sizeStats={{sizeStats}}
            @isVirtualSizeColumnShown={{this.isVirtualSizeColumnShown}}
          />
        </tbody>
      </table>
    </div>
  {{/each}}
{{else}}
  <div class="current-size-table-container">
    <table class="current-size-table table table-info centered-text">
      <thead>
        <tr>
          <td class="provider-cell-header">
            {{tt this "provider"}}
            <div
              class="provider-sorting-trigger"
              onclick={{action "onSortingIconClick"}}
            >
              <OneIcon
              @icon="text-olist provider-sorting-icon"
            />
            </div>
          </td>
          <td>
            {{tt this "fileCounters.containsLabel"}}
            <OneLabelTip @title={{tt this "containsTip"}} />
          </td>
          <td>
            {{tt this "fileCounters.logicalSizeLabel"}}
            <OneLabelTip @title={{tt this "logicalSizeTip"}} />
          </td>
          <td>
            {{tt this "fileCounters.physicalSizeLabel"}}
            <OneLabelTip @title={{tt this "physicalSizeTip"}} />
          </td>
          {{#if this.isVirtualSizeColumnShown}}
            <td>
              {{tt this "fileCounters.virtualSizeLabel"}}
              <OneLabelTip @title={{tt this "virtualSizeTip"}} />
            </td>
          {{/if}}
        </tr>
      </thead>
      <tbody>
        {{#each sortedDirSizeStatsValues key="provider" as |sizeStats|}}
          <FileBrowser::SizeStatsPerProviderTable::ProviderRow
            @sizeStats={{sizeStats}}
            @isVirtualSizeColumnShown={{this.isVirtualSizeColumnShown}}
            @currentProviderId={{this.currentProviderId}}
          />
        {{/each}}
      </tbody>
    </table>
  </div>
{{/if}}
<FileBrowser::SizeStatsPerProviderTable::ProviderSortingPopover
  @isOpened={{sortingIconClick}}
  @triggerSelector={{concat "#" elementId " .provider-sorting-trigger"}}
  @sortingMethodChanged={{action "sortingMethodChanged"}}
/>

