<PromiseProxyContainer
  @proxy={{dataProxy}}
  @sizeClass="lg"
  @loadingLabel={{oneproviderName}}
>
  <div class="one-collapsible-list entries-table {{unless shares.length "hidden"}}">
    <div class="table-start-row"></div>
    <div class="first-row" style={{infiniteScroll.firstRowModel.style}}></div>
    {{#each conflictableShares as |share|}}
      <SpaceShares::ListItem
        class="data-row"
        @space={{space}}
        @share={{share}}
        @getShareUrl={{action "getShareUrl"}}
        @onStartRemoveShare={{action "startRemoveShare"}}
        @onStartRenameShare={{action "startRenameShare"}}
      />
    {{/each}}
  </div>
  {{#unless shares.length}}
    <ContentSharesEmpty @forSpace={{true}} @dataTabUrl={{dataTabUrl}} />
  {{/unless}}
</PromiseProxyContainer>
