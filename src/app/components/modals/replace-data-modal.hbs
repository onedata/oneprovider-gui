<GlobalModal
  @classNames="replace-data-modal"
  @modalId={{this.modalId}}
  @allowClose={{false}}
  @onHide={{this.hide}}
  as |modal|
>
  <modal.header>
    <h1>{{tt this "header"}}</h1>
  </modal.header>
  <modal.body>
    <p>{{tt this "intro"}}</p>
    <div class="current-file-container file-container">
      <SingleFileInfo @file={{this.file}} class="existing-file-info" />
      <div class="current-file-download-container">
        <OneButton
          @onClick={{this.download}}
          @size="sm"
        >
          <OneIcon @icon="browser-download" />
          {{tt this "download"}}
        </OneButton>
      </div>
    </div>
    <div class="btn-group-tabs files-separator">
      <div class="box-item">
        <strong>{{tt this "replaceContentWith"}}</strong>
      </div>
    </div>
    <div class="current-file-container file-container">
      <BrowsableFileInfo
        @placeholder={{tt this "selectFilePlaceholder"}}
        @file={{this.newFile}}
        class="new-file-info"
      />
      <div class="current-file-download-container">
        <OneButton
          @size="sm"
          @onClick={{this.browse}}
        >
          {{tt this "browse"}}
        </OneButton>
      </div>
    </div>
    <div class="acknowledge-checkbox-group">
      <OneCheckbox
        class="one-checkbox-understand"
        @checked={{this.acknowledgeChecked}}
        @update={{this.toggleAcknowledge}}
      />
      <div
        class="text-acknowledge clickable"
        onclick={{this.toggleAcknowledge}}
      >
        {{tt this "acknowledgeText"}}
      </div>
    </div>
  </modal.body>
  <modal.footer>
    <input
      {{did-insert this.registerFileInput}}
      type="file"
      class="new-file-input"
      onchange={{this.changeFile}}
    >
    <OneButton
      @onClick={{modal.close}}
    >
      {{tt this "cancel"}}
    </OneButton>
    <OneButton
      @type="primary"
      @disabled={{this.proceedDisabled}}
    >
      <OneIcon @icon="browser-upload" />
      {{tt this "proceed"}}
    </OneButton>
  </modal.footer>
</GlobalModal>
