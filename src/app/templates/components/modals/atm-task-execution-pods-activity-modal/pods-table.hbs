<ScrollableTable class="table one-infinite-list">
  <Modals::AtmTaskExecutionPodsActivityModal::PodsTable::HeaderRow
    @allPodsCount={{podRows.length}}
    @currentPodsCount={{currentPodRows.length}}
    @podsFilter={{podsFilter}}
    @onPodsFilterChange={{action "podsFilterChange"}}
  />
  {{#each filteredPodRows key="podId" as |podRow|}}
    <Modals::AtmTaskExecutionPodsActivityModal::PodsTable::PodRow
      class="data-row"
      @podId={{podRow.podId}}
      @podActivity={{podRow.podActivity}}
      @isSelected={{eq podRow.podId selectedPodId}}
      @onSelect={{onPodSelect}}
    />
  {{else}}
    <tr class="pods-table-no-pods-row">
      <td colspan="3">{{noPodsMessage}}</td>
    </tr>
  {{/each}}
</ScrollableTable>
