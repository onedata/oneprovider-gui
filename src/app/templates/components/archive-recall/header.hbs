<h1>
  <span class="header-text">
    {{tt this "headerText"}}
  </span>
  {{#if (media "isMobile")}}
    <OneIcon
      @icon="sign-question-rounded"
      class="archive-recall-header-hint-trigger hint-trigger clickable"
    />
    <OneSwitchablePopoverModal
      class="archive-recall-hint"
      @triggersConfiguration=".archive-recall-header-hint-trigger"
      @popoverStyle="archive-recall-hint-info"
      @modalClass="modal-compact-help"
      @layoutType="modal"
      as |ospm|
    >
      <ospm.modal.header>
        <h1>{{tt this "recallHintTitle"}}</h1>
      </ospm.modal.header>
      <ospm.modal.body>
        <p>{{tt this "intro"}}</p>
      </ospm.modal.body>
      <ospm.modal.footer>
        <div class="btn-toolbar text-right visible-xs-block">
          <OneButton class="btn btn-sm" @type="info" @onClick={{ospm.close}}>
            {{tt this "hintClose"}}
          </OneButton>
        </div>
      </ospm.modal.footer>
    </OneSwitchablePopoverModal>
  {{/if}}
</h1>
<ModalArchiveSubheader @archives={{array archive}}>
  <span class="archive-files-info">(<ArchiveContentCount @archive={{archive}} />)</span>
</ModalArchiveSubheader>
{{#unless (media "isMobile")}}
  <p class="intro-text">
    {{tt this "intro"}}
  </p>
{{/unless}}
{{yield}}
