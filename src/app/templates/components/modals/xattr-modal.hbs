<GlobalModal
  @classNames="xattr-modal"
  @modalId={{modalId}}
  @allowClose={{false}}
  @onHide={{action "onHide"}}
  as |modal|
>

  <modal.header>
    <h1>{{tt this "header"}}</h1>
    <ModalFileSubheader @files={{files}} />
    <h2 class="normal-case xattr-key-subheader">
      <TruncatedString>
        <div class="inline-icon-container">
          <OneIcon @icon="browser-metadata" />
        </div>
        {{xattrKey}}
      </TruncatedString>
    </h2>
  </modal.header>

  <modal.body>
    <div class="xattr-key-value">
      <textarea
        class="form-control no-resize"
        value={{editValue}}
        rows="5"
        oninput={{action (mut editValue) value="target.value"}}
        disabled={{isSaving}}
        autofocus=true
        readonly={{not isModifiedMode}}
      />
    </div>
  </modal.body>

  <modal.footer>
    {{#if isModifiedMode}}
      <OneButton
        @type="warning"
        @onClick={{action "discard"}}
      >
        {{tt this "discard"}}
      </OneButton>
      <OneButton
        @type="primary"
        @buttonType="submit"
        @onClick={{action "submit"}}
        @disabled={{submitDisabled}}
      >
        {{tt this "save"}}
      </OneButton>
    {{else}}
      <div class="link-texts-container">
        <OneCopyButton
          @class="clipboard-btn xattr-value-clipboard-btn clickable"
          @clipboardText={{editValue}}
        >
          <span class="copy-text">
            {{tt this "copy"}}
          </span>
          <div class="inline-icon-container copy-icon-container">
            <OneIcon @icon="browser-copy" />
          </div>
        </OneCopyButton>
        |
        <div
          class="modify-text"
          onClick={{action (mut isModifiedMode)}}
        >
          {{tt this "modify"}}
          <div class="inline-icon-container edit-icon-container">
            <OneIcon @icon="browser-rename" />
          </div>
        </div>
      </div>
      <OneButton
        @onClick={{modal.close}}
      >
        {{tt this "close"}}
      </OneButton>
    {{/if}}
  </modal.footer>

</GlobalModal>
