<OneModal
  class="archive-create-modal"
  @open={{open}}
  @size="xl"
  @backdropClose={{false}}
  @keyboard={{false}}
  @onHide={{action "hide"}}
  as |modal|
>
  <ArchiveCreate
    @dataset={{dataset}}
    @modal={{modal}}
    @options={{options}}
    @spacePrivileges={{space.privileges}}
    @onClose={{action "hide"}}
    @onSubmit={{action "submit"}}
  />
</OneModal>
