<OneModal
  @modalClass="db-view-modal"
  @open={{open}}
  @onHide={{action "close"}}
  @onHidden={{action "onHidden"}}
  @size="lg"
  as |modal|
>
  <modal.header>
    <h1>{{tt this "header"}}</h1>
  </modal.header>
  <modal.body>
    <PromiseProxyContainer @proxy={{dbViewProxy}}>
      <BsTab class="bs-tab-onedata bs-tab-modern" as |tab|>
        <tab.pane @title={{tt this "tabs.general"}}>
          <DbViewModal::TabGeneral
            @viewName={{dbViewName}}
            @spaceName={{space.name}}
            @spatial={{dbView.spatial}}
            @providerNames={{providerNamesProxy.content}}
            @viewOptions={{dbView.viewOptions}}
          />
        </tab.pane>
        <tab.pane @title={{tt this "tabs.mapFunction"}}>
          <DbViewModal::TabFunction
            @functionType="map"
            @functionString={{dbView.mapFunction}}
          />
        </tab.pane>
        <tab.pane @title={{tt this "tabs.reduceFunction"}}>
          <DbViewModal::TabFunction
            @functionType="reduce"
            @functionString={{dbView.reduceFunction}}
          />
        </tab.pane>
      </BsTab>
    </PromiseProxyContainer>
  </modal.body>
  <modal.footer class="btn-toolbar">
    <OneButton @type="primary" @onClick={{modal.close}}>
      {{tt this "close"}}
    </OneButton>
  </modal.footer>
</OneModal>
