{{#let
  (component this.modal.header)
  (component this.modal.body)
  (component this.modal.footer)
  as |modalHeader modalBody modalFooter|
}}
  <modalHeader class="dataset-protection-part dataset-protection-modal-header">
    <DatasetProtection::SummaryHeader @dataset={{browsableDataset}} @file={{file}} />
  </modalHeader>

  <modalBody class="dataset-protection-part dataset-protection-modal-body">
    <DatasetProtection::Table
      @fileDatasetSummaryProxy={{fileDatasetSummaryProxy}}
      @directDatasetProxy={{directDatasetProxy}}
      @ancestorDatasetsProxy={{ancestorDatasetsProxy}}
      @mode={{mode}}
      @file={{file}}
      @editPrivilege={{editPrivilege}}
      @insufficientEditPrivilegesMessage={{insufficientEditPrivilegesMessage}}
      @close={{close}}
      @getDataUrl={{getDataUrl}}
      @getDatasetsUrl={{getDatasetsUrl}}
    />
  </modalBody>

  <modalFooter class="dataset-protection-part dataset-protection-modal-footer">
    <OneButton @onClick={{action close}} @type="default" class="close-btn">
      {{tt this "close"}}
    </OneButton>
  </modalFooter>
{{/let}}