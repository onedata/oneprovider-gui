<PromiseProxyContainer @proxy={{browserRequiredDataProxy}}>
  <FileBrowser
    @browserModel={{browserModel}}
    @parentModalDialogSelector={{parentModalDialogSelector}}
    @showSelectionToolkit={{false}}
    @contentScroll={{contentScroll}}
    @ignoreDeselectSelector={{ignoreDeselectSelector}}
    @updateDirEntityId={{action "changeDirId"}}
  />
</PromiseProxyContainer>

<FilesystemSelectBrowserExtension
  @selectorModel={{this}}
  @browserModel={{browserModel}}
/>

{{yield}}