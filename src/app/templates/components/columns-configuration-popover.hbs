<RenderLater @triggerRender={{isOpened}}>
  <OneWebuiPopover
    class="columns-configuration"
    @popoverStyle={{popoverStyle}}
    @open={{isOpened}}
    @triggerSelector={{triggerSelector}}
    as |popover|
  >
    <ClickOutside
      @onClickOutside={{action (mut isOpened) false}}
      @exceptSelector={{triggerSelector}}
    >
      <OneCarousel @animated={{false}} @activeSlideId={{activeSlide}} as |carousel|>
        <carousel.slide @slideId="column-configuration">
          <h1 class="column-configuration-header">
            {{tt this "header"}}
          </h1>
          <PerfectScrollbarElement
            class="columns-configuration-list"
            as |perfectScrollbarContainer|
          >
            <ul class="columns-list">
              {{#each columnsConfiguration.columnsOrder as |columnName index|}}
                <ColumnsConfigurationPopover::ColumnItem
                  @columnName={{columnName}}
                  @columnValue={{get columnsConfiguration.columns columnName}}
                  @translationKey={{translationKey}}
                  @isMoveUpIconDisabled={{eq index 0}}
                  @isMoveDownIconDisabled={{eq index lastIndexColumn}}
                  @isArrowTooltipVisible={{isArrowTooltipVisible}}
                  @checkboxChanged={{action "checkboxChanged"}}
                  @moveColumnDown={{action "moveColumnDown"}}
                  @moveColumnUp={{action "moveColumnUp"}}
                  @dragStartAction={{dragStartAction}}
                  @dragEndAction={{dragEndAction}}
                  @openColumnEditor={{action "openColumnEditor"}}
                  @removeMetadataColumn={{action "removeMetadataColumn"}}
                  @isColumnListVisible={{eq activeSlide "column-configuration"}}
                  @columnIndex={{index}}
                  @onHeadingDrag={{action "headingDrag" columnName}}
                  @onHeadingDragEnd={{action "headingDragEnd"}}
                  @onHeadingDragOver={{action "headingDragOver"}}
                  @onHeadingDragLeave={{action "headingDragLeave"}}
                  @onHeadingDrop={{action "headingDrop"}}
                  @isDropBorderShown={{isDropBorderShown}}
                  @previewMode={{browserModel.previewMode}}
                />
              {{/each}}
              <div class="space-between-item-area"></div>
            </ul>
          </PerfectScrollbarElement>
          {{#if columnsConfiguration.hasMetadataSettings}}
            <div
              class="add-new-column new-column-item"
              onClick={{action "goXattrConfiguration"}}
            >
              <OneButton
                @id={{btnId}}
                class="add-new-column-btn btn-success clickable"
                @type="default"
              >
                <OneIcon @icon="plus" class="adder-icon" />
              </OneButton>
              <span class="new-column-text">{{tt this "addNewColumn"}}</span>
            </div>
          {{/if}}
        </carousel.slide>
        <carousel.slide @slideId="column-add">
          {{#if (eq activeSlide "column-add")}}
            <ColumnsConfigurationPopover::ColumnEditor
              @isNewColumn={{true}}
              @xattrOptionsProxy={{xattrOptionsProxy}}
              @jsonKeyOptionsProxy={{jsonKeyOptionsProxy}}
              @onSubmitColumn={{action "submitColumn"}}
              @onGoBack={{action "goBack"}}
              @columnsConfiguration={{columnsConfiguration}}
            />
          {{/if}}
        </carousel.slide>
        <carousel.slide @slideId="column-modify">
          {{#if (eq activeSlide "column-modify")}}
            <ColumnsConfigurationPopover::ColumnEditor
              @isNewColumn={{false}}
              @xattrOptionsProxy={{xattrOptionsProxy}}
              @jsonKeyOptionsProxy={{jsonKeyOptionsProxy}}
              @onSubmitColumn={{action "submitColumn"}}
              @onGoBack={{action "goBack"}}
              @columnsConfiguration={{columnsConfiguration}}
              @initialDisplayedName={{modifiedDisplayedName}}
              @initialXattrKey={{modifiedXattrKey}}
              @initialJsonQueryType={{modifiedJsonQueryType}}
              @initialMetadataType={{modifiedMetadataType}}
              @initialJsonKey={{modifiedJsonKey}}
              @initialJsonQuery={{modifiedJsonQuery}}
            />
          {{/if}}
        </carousel.slide>
      </OneCarousel>
    </ClickOutside>
  </OneWebuiPopover>
</RenderLater>
