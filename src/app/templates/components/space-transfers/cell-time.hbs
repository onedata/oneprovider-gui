<div class="date-text">
  {{date-format (get record propertyName) format="date" blank="—"}}
</div>
{{#if (and (get record propertyName) (not-eq (get record propertyName) "‐"))}}
  <div class="time-text">
    {{date-format (get record propertyName) format="timeWithSeconds" blank="—"}}
  </div>
{{/if}}