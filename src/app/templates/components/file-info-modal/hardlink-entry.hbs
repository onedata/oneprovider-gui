<div class="icon-col">
  <OneIcon class="file-type-icon" @icon={{icon}} />
</div>
<div class="content-col">
  <TruncatedString class="file-name">{{file.name}}</TruncatedString>
  <small class="file-path">
    <span class="file-path-label">{{tt this "pathLabel"}}:</span>
    {{#if file}}
      <FilePath
        class="anchor-container"
        @file={{file}}
        @target={{navigateLinkTarget}}
        @onLinkClicked={{action "linkClicked"}}
      />
    {{else}}
      <em>{{tt this "unknownPath"}}</em>
    {{/if}}
  </small>
</div>
