<PromiseProxyContainer
  @proxy={{spaceProxy}}
  @spinnerBlockClass="absolute-middle-centered"
  @sizeClass="lg"
  @loadingLabel={{oneproviderLoadingLabel}}
>
  {{#if hasPermissions}}
    <SpaceTransfers
      @space={{spaceProxy.content}}
      @fileId={{fileEntityId}}
      @tab={{tab}}
      @resetQueryParams={{action "resetQueryParams"}}
      @changeListTab={{action "changeListTab"}}
      @closeFileTab={{action "closeFileTab"}}
    />
  {{else}}
    <Errors::NoPermissions class="no-permissions-space-transfers" />
  {{/if}}
</PromiseProxyContainer>
