<div
  class={{concat-classes "after-drop-area" (if isDropBorderShown "drop-area")}}
  ondragover={{action "headingDragOver"}}
  ondragleave={{action "headingDragLeave"}}
  ondrop={{action "headingDrop"}}
></div>
<div class="fb-table-first-col-container">
  <div class="table-header-text">{{tt this "headers.name.firstColumnName"}}</div>
  {{#if renderArchiveDipSwitch}}
    <ArchiveDipSwitch
      @disabled={{not isArchiveDipAvailable}}
      @archiveDipMode={{archiveDipMode}}
      @onArchiveDipModeChange={{onArchiveDipModeChange}}
    />
  {{/if}}
  <div class="spacer"></div>
  <div class="table-header-status-bar">{{yield}}</div>
</div>