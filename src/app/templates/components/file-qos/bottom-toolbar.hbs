<div class="btn-tooltip-container">
  <OneButton
    @type="primary"
    @buttonType="submit"
    @onClick={{action "addQosRequirement"}}
    class="add-qos-requirement-btn"
    @disabled={{isAddDisabled}}
  >
    {{tt this "addQosRequirement"}}
  </OneButton>
  {{#if addDisabledTip}}
    <OneTooltip @title={{addDisabledTip}} />
  {{/if}}
</div>
